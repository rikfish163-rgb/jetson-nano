<launch>
  <!-- Only the lidar driver and read-only web viewer; no vehicle control. -->
  <arg name="start_lidar" default="true"/>
  <arg name="serial_port" default="/dev/ttyUSB0"/>
  <arg name="port" default="8090"/>
  <arg name="scan_topic" default="/scan"/>
  <node if="$(arg start_lidar)" name="ls01b_v2" pkg="ls01b_v2" type="ls01b_v2" output="screen" required="true">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="frame_id" value="laser_link"/>
    <param name="serial_port" value="$(arg serial_port)"/>
    <param name="baud_rate" value="460800"/>
    <param name="angle_resolution" value="0.25"/>
    <param name="zero_as_max" value="false"/>
    <param name="min_as_zero" value="false"/>
    <param name="robot_radius" value="0.2"/>
    <param name="center_x" value="-0.105"/>
    <param name="center_y" value="0"/>
  </node>
  <node name="lidar_web_test" pkg="lidar_broadcast" type="lidar_web_test.py" output="screen" required="true">
    <param name="port" value="$(arg port)"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
  </node>
</launch>

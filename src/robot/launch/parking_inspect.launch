<launch>
  <!-- Stationary inspection only: no controller, bridge or actuator nodes. -->
  <arg name="front_device" default="/dev/v4l/by-path/platform-70090000.xusb-usb-0:2.3:1.0-video-index0"/>
  <arg name="front_fps" default="10"/>
  <arg name="start_camera" default="true"/>
  <arg name="start_lidar" default="true"/>
  <arg name="algorithm" default="partial_model"/>
  <node if="$(arg start_camera)" pkg="usb_cam" type="usb_cam_node" name="parking_test_camera" ns="front" output="screen">
    <remap from="/front/parking_test_camera/image_raw" to="/front/usb_cam/image_raw"/>
    <param name="video_device" value="$(arg front_device)"/>
    <param name="image_width" value="640"/>
    <param name="image_height" value="360"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="framerate" value="$(arg front_fps)"/>
    <param name="camera_frame_id" value="front_camera"/>
    <param name="camera_info_url" value="file://$(find yihan_ros_pkg)/calibration/front_640x360.yaml"/>
  </node>
  <include if="$(arg start_lidar)" file="$(find ls01b_v2)/launch/ls01b_v2.launch"/>
  <node pkg="robocup_competition" type="parking_inspect.py" name="parking_inspect" output="screen">
    <param name="config_file" value="$(find robocup_competition)/config/competition.yaml"/>
    <param name="image_topic" value="/front/usb_cam/image_raw"/>
    <param name="algorithm" value="$(arg algorithm)"/>
  </node>
</launch>

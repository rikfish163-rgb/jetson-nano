<launch>
  <!-- Camera/observations ONLY: no bridge, controller or base driver. -->
  <arg name="start_camera" default="true"/>
  <arg name="front_device" default="/dev/v4l/by-path/platform-70090000.xusb-usb-0:2.3:1.0-video-index0"/>
  <arg name="projection_file" default="$(find robocup_competition)/parallel_parking/reference_camera.yaml"/>
  <node if="$(arg start_camera)" pkg="usb_cam" type="usb_cam_node" name="parallel_reference_camera" ns="front" output="screen" required="true">
    <remap from="/front/parallel_reference_camera/image_raw" to="/front/usb_cam/image_raw"/>
    <param name="video_device" value="$(arg front_device)"/>
    <param name="image_width" value="640"/>
    <param name="image_height" value="360"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="framerate" value="10"/>
    <param name="camera_frame_id" value="front_camera"/>
    <param name="camera_info_url" value="file://$(find yihan_ros_pkg)/calibration/front_640x360.yaml"/>
  </node>
  <node pkg="robocup_competition" type="reference_node.py" name="parallel_p1_reference" output="screen" required="true">
    <param name="config_file" value="$(find robocup_competition)/config/competition.yaml"/>
    <param name="projection_file" value="$(arg projection_file)"/>
    <param name="image_topic" value="/front/usb_cam/image_raw"/>
  </node>
</launch>

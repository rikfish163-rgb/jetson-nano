<launch>
  <arg name="framerate" default="15"/>
  <arg name="device" default="/dev/v4l/by-path/platform-70090000.xusb-usb-0:2.3:1.0-video-index0"/>
  <node pkg="usb_cam" type="usb_cam_node" name="sign_capture_camera" ns="front" output="screen">
    <remap from="/front/sign_capture_camera/image_raw" to="/front/usb_cam/image_raw"/>
    <param name="video_device" value="$(arg device)"/>
    <param name="image_width" value="640"/>
    <param name="image_height" value="360"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="camera_frame_id" value="front_camera"/>
    <param name="camera_info_url" value="file://$(find yihan_ros_pkg)/calibration/front_640x360.yaml"/>
  </node>
</launch>

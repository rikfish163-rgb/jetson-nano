<launch>
  <!-- Observation only: no controller, actuator or motion publisher. -->
  <arg name="output"/>
  <arg name="seconds" default="300"/>
  <arg name="max_mb" default="650"/>
  <node pkg="rosbag" type="record" name="parking_diagnostic_record" output="screen"
        args="--lz4 --buffsize=128 --min-space=300M --size=$(arg max_mb) --duration=$(arg seconds) -O $(arg output)
          /front/usb_cam/image_raw/compressed /rear/usb_cam/image_raw/compressed
          /debug/lane_tracking /competition/debug/parking_timed
          /competition/debug/rear_white /competition/debug/rear_blue
          /scan /vision/lane_observation /vision/lane_calibration
          /competition/parking_timed_scene /competition/parking_side_bays
          /competition/parking_hint /competition/status /competition/lane_target
          /competition/sign /competition/rear_sign /competition/ground
          /ackermann_cmd /base_controller/status /rosout"/>
</launch>

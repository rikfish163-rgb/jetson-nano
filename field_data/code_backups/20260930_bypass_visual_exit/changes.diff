+def _right_lane_exit(ctx,task,now):
+    """Confirm measured return-lane geometry after passing the trigger."""
+    trigger=task.get('trigger_world')
+    passed=(trigger is not None and local(ctx.pose,trigger)[0] <
+            -ctx.cfg['rear_overhang']-ctx.cfg['obstacle_margin'])
+    points=sorted(local(ctx.pose,p) for p in ctx.lane)
+    angles=[math.atan2(b[1]-a[1],b[0]-a[0]) for a,b in zip(points,points[1:])]
+    ready=(task['elapsed_s']>=2. and passed and
+        ctx.call('obstacle','scan_ready',now) and
+        ctx.call('lane','lane_tracking_ready',now) and
+        ctx.lane_confidence>=ctx.cfg['lane_min_confidence'] and len(points)>=3 and
+        .05<points[0][0]<=1. and points[-1][0]-points[0][0]>=.20 and
+        abs(points[0][1])<=.18 and all(.05<x<=1.5 and abs(y)<=.45 for x,y in points) and
+        all(b[0]-a[0]>.015 for a,b in zip(points,points[1:])) and
+        all(abs(a)<=math.radians(30) for a in angles) and
+        all(abs(b-a)<=math.radians(20) for a,b in zip(angles,angles[1:])))
+    evidence=task.get('lane_exit')
+    if not ready:
+        task['lane_exit']=None
+        return False
+    if evidence is None or not 0<=ctx.lane_stamp-evidence['stamp']<=ctx.cfg['sensor_timeout']:
+        evidence=dict(stamp=-1.,since=ctx.lane_stamp,frames=0)
+        task['lane_exit']=evidence
+    if ctx.lane_stamp>evidence['stamp']:
+        evidence.update(stamp=ctx.lane_stamp,frames=evidence['frames']+1,
+            near_lateral_m=points[0][1],heading_deg=math.degrees(angles[0]),
+            right_elapsed_s=task['elapsed_s'])
+    return evidence['frames']>=3 and ctx.lane_stamp-evidence['since']>=.15-1e-9
+

+def _trial_exit_candidate(ctx, now):
+    """Near tangent plus turn progress; require distinct post-sequence images."""
+    cfg,u=ctx.cfg,ctx.uturn
+    reason='ok'
+    if not ctx.call('lane','lane_valid',now) or ctx.lane_stamp<u['trial_exit_started']:
+        reason='stale_or_invalid_lane'
+    elif u['estimated_turn_deg']<cfg.get('uturn_trial_exit_min_turn_deg',150):
+        reason='turn_incomplete'
+    else:
+        points=sorted(p for p in (local(ctx.pose,q) for q in ctx.lane) if .05<p[0]<=1.1)
+        if len(points)<2:
+            reason='exit_lane_too_far'
+        else:
+            heading=math.degrees(math.atan2(points[1][1]-points[0][1],points[1][0]-points[0][0]))
+            u.update(exit_heading_deg=heading,exit_lateral_m=points[0][1])
+            if abs(heading)>cfg.get('uturn_trial_exit_heading_deg',20):
+                reason='exit_heading'
+            elif abs(points[0][1])>cfg['exit_lateral_tolerance']:
+                reason='exit_lateral'
+    if reason!='ok':ctx.exit_count=0
+    if ctx.lane_stamp>ctx.exit_stamp:
+        if ctx.lane_stamp-ctx.exit_stamp>cfg['sensor_timeout']:ctx.exit_count=0
+        ctx.exit_stamp=ctx.lane_stamp
+        if reason=='ok':ctx.exit_count+=1
+    u.update(exit_reason=reason,exit_frames=ctx.exit_count)
+    return reason=='ok'

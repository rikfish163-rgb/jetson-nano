+    if (u['estimated_turn_deg']<cfg.get('uturn_trial_exit_min_turn_deg',150) or
+            ctx.lane_stamp<u['trial_exit_started'] or not ctx.call('lane','lane_valid',now)):
+        return fallback
+    points=sorted(p for p in (local(ctx.pose,q) for q in ctx.lane) if .05<p[0]<=1.1)
+    if len(points)<2:return fallback
+    heading=math.atan2(points[1][1]-points[0][1],points[1][0]-points[0][0])
+    if abs(heading)>math.radians(60) or abs(points[0][1])>cfg['lane_width']/2:

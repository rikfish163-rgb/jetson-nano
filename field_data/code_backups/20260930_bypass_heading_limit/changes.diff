+def _right_heading_exit(ctx,task):
+    """End full-lock counterturn before rotating past the incoming heading."""
+    angle=task.get('left_turn_angle_rad',0.)
+    origin=task.get('right_origin_heading_rad')
+    if origin is None or angle<=math.radians(5):
+        return False
+    returned=wrap(origin-ctx.pose[2])
+    task['right_geometry']=dict(left_angle_deg=math.degrees(angle),
+        returned_angle_deg=math.degrees(returned),
+        remaining_angle_deg=math.degrees(angle-returned))
+    # Leave a small margin for the following control tick and wheel response.
+    # The lane controller handles lateral recentering at bend speed.
+    return returned>=angle-math.radians(3)
 
 
